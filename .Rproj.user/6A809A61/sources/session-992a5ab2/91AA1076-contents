# Predictive Analytics

## Multiple Linear Regression

### Full Model

```{r regression-full}
model_data <- data[, c("Morale_Index", "Support_Index", "EnvironmentSatisfaction",
                       "RelationshipSatisfaction", "WorkLifeBalance", "OverTime_Num",
                       "BusinessTravel", "Age", "MonthlyIncome", "JobLevel",
                       "YearsAtCompany", "Gender", "Department")]

full_model <- lm(Morale_Index ~ ., data = model_data)
summary(full_model)
```

### Backward Selection (AIC)

```{r backward-selection, results='hide'}
final_model <- step(full_model, direction = "backward", trace = 1)
```

### Final Model

```{r final-model}
summary(final_model)
```

```{r model-metrics}
r_sq <- summary(final_model)$r.squared
adj_r_sq <- summary(final_model)$adj.r.squared
```

-   R-squared: `r round(r_sq, 4)`
-   Adjusted R-squared: `r round(adj_r_sq, 4)`

### Regression Diagnostics

```{r diagnostics, fig.width=10, fig.height=8}
par(mfrow = c(2, 2))
plot(final_model)
```

### Multicollinearity Check (VIF)

```{r vif}
if (length(coef(final_model)) > 1) {
  vif_values <- car::vif(final_model)
  if (is.matrix(vif_values)) {
    vif_df <- data.frame(Variable = rownames(vif_values), vif_values, row.names = NULL, check.names = FALSE)
    vif_df[,-1] <- lapply(vif_df[,-1], function(x) round(as.numeric(x), 3))
  } else {
    vif_df <- data.frame(Variable = names(vif_values), VIF = round(as.numeric(vif_values), 3))
  }
} else {
  vif_df <- data.frame(Note = "Final model contains only an intercept. VIF is not applicable.")
}
knitr::kable(vif_df, row.names = FALSE, caption = "Variance Inflation Factors")
```

## Naive Bayes Classification

### Train-Test Split

```{r train-test-split}
train_idx <- createDataPartition(data$Morale_Category, p = 0.7, list = FALSE)
train_data <- data[train_idx, ]
test_data <- data[-train_idx, ]
```

### Model Training

```{r naive-bayes-train}
nb_features <- c("Environment_F", "Relationship_F", "WorkLife_F", "OverTime",
                 "BusinessTravel", "Support_Index")
nb_formula <- as.formula(paste("Morale_Category ~", paste(nb_features, collapse = " + ")))

nb_model <- naiveBayes(nb_formula, data = train_data)
nb_model$apriori
```

### Evaluation

```{r nb-evaluation}
nb_pred <- predict(nb_model, newdata = test_data)
cm <- confusionMatrix(nb_pred, test_data$Morale_Category)
cm
```

-   Accuracy: `r round(cm$overall["Accuracy"] * 100, 2)`%
-   Kappa: `r round(cm$overall["Kappa"], 4)`

```{r nb-per-class}
knitr::kable(round(cm$byClass[, c("Sensitivity", "Specificity", "Precision", "Recall", "F1")], 4),
             caption = "Per-Class Performance Metrics")
```

## New Employee Prediction

Use this block to input one employee profile and get model-based morale predictions.

```{r new-employee-prediction}
# Edit this row to score a new employee profile.
new_employee <- data.frame(
  Age = 35,
  MonthlyIncome = 6500,
  YearsAtCompany = 5,
  JobLevel = 2,
  OverTime = "No",
  BusinessTravel = "Travel_Rarely",
  EnvironmentSatisfaction = 3,
  RelationshipSatisfaction = 3,
  WorkLifeBalance = 3,
  Gender = "Male",
  Department = "Sales",
  stringsAsFactors = FALSE
)

# Match factor levels with dataset.
factor_cols <- names(data)[sapply(data, is.factor)]
for (col in factor_cols) {
  if (col %in% names(new_employee)) {
    new_employee[[col]] <- factor(new_employee[[col]], levels = levels(data[[col]]))
  }
}

# Derived features used by models.
new_employee$OverTime_Num <- ifelse(new_employee$OverTime == "Yes", 1, 0)
new_employee$Environment_F <- factor(new_employee$EnvironmentSatisfaction,
                                     levels = 1:4, labels = sat_levels, ordered = TRUE)
new_employee$Relationship_F <- factor(new_employee$RelationshipSatisfaction,
                                      levels = 1:4, labels = sat_levels, ordered = TRUE)
new_employee$WorkLife_F <- factor(new_employee$WorkLifeBalance,
                                  levels = 1:4, labels = sat_levels, ordered = TRUE)

z_from_data <- function(x, base) (x - mean(base)) / sd(base)
travel_score <- ifelse(new_employee$BusinessTravel == "Non-Travel", 2,
                       ifelse(new_employee$BusinessTravel == "Travel_Rarely", 1, 0))

new_employee$Support_Index <- rowMeans(cbind(
  z_from_data(new_employee$EnvironmentSatisfaction, data$EnvironmentSatisfaction),
  z_from_data(new_employee$RelationshipSatisfaction, data$RelationshipSatisfaction),
  z_from_data(new_employee$WorkLifeBalance, data$WorkLifeBalance),
  z_from_data(1 - new_employee$OverTime_Num, 1 - data$OverTime_Num),
  z_from_data(travel_score, ifelse(data$BusinessTravel == "Non-Travel", 2,
                                   ifelse(data$BusinessTravel == "Travel_Rarely", 1, 0)))
))

# Predictions
pred_morale_index <- as.numeric(predict(final_model, newdata = new_employee))
pred_morale_binary <- ifelse(pred_morale_index > median(data$Morale_Index), "High", "Low")
pred_morale_category <- as.character(predict(nb_model, newdata = new_employee))

model_note <- ifelse(length(coef(final_model)) == 1,
                     "Regression model is intercept-only; score has limited personalization.",
                     "Regression model uses selected predictors from backward AIC.")

pred_tbl <- data.frame(
  Predicted_Morale_Index = pred_morale_index,
  Predicted_Binary_Morale = pred_morale_binary,
  Predicted_Morale_Category_NB = pred_morale_category,
  Note = model_note
)
pred_tbl$Predicted_Morale_Index <- round(pred_tbl$Predicted_Morale_Index, 4)

knitr::kable(pred_tbl, caption = "Prediction for New Employee Row")
```

